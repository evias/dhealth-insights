# Backend Configuration
# Host and port for the server to bind to
APP_BIND_HOST=localhost
APP_BIND_PORT=3000
APP_BUILD=development

# BaseURL for the public API
API_BASE_URL=localhost:3000/api/v1

# API Key for secured write operations, as a comma-separated string.
AUTH_API_KEY=

# Path to the log file (relative to project root, or absolute path)
APP_LOGS_FILE=application.log

# Resend API Key for emailing features.
RESEND_API_KEY=
